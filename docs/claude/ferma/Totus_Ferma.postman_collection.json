{
  "info": {
    "name": "Totus Club · Ferma (OFD.ru)",
    "description": "Проверка API онлайн-кассы Ferma для Totus Club. Составлено 20.10.2026 по документации v2.88 и прогону на ferma-test.ofd.ru. Порядок: 0 → 1 → 2 → 3 → 4. Окружение «Ferma TEST» — публичный стенд OFD.ru; «Ferma PROD» — заполнить после подключения ТОТУСКЛАБ. Подробно — claude/FERMA_TESTING_RU.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Токен Ferma: берём заново, если его нет или до конца жизни меньше 5 минут.",
          "// Запрос «0.1 Получить токен» токен не подставляет — он его создаёт.",
          "if (pm.info.requestName.indexOf('0.') === 0) { return; }",
          "const exp = pm.environment.get('fermaTokenExp');",
          "const fresh = pm.environment.get('fermaToken') && exp && (Date.now() < Date.parse(exp + 'Z') - 5 * 60 * 1000);",
          "if (!fresh) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/Authorization/CreateAuthToken',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ Login: pm.environment.get('login'), Password: pm.environment.get('password') }) }",
          "  }, function (err, res) {",
          "    if (err) { console.error('Ferma auth error', err); return; }",
          "    const d = res.json().Data || {};",
          "    pm.environment.set('fermaToken', d.AuthToken);",
          "    pm.environment.set('fermaTokenExp', d.ExpirationDateUtc);",
          "    console.log('Ferma: новый токен до ' + d.ExpirationDateUtc + ' UTC');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Авторизация",
      "item": [
        {
          "name": "0.1 Получить токен",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Authorization/CreateAuthToken",
            "description": "Логин и пароль — из окружения. Токен действует до ExpirationDateUtc (UTC+0). Остальные запросы коллекции получают токен сами.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Login\": \"{{login}}\",\n  \"Password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200, Status = Success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().Status).to.eql('Success');",
                  "});",
                  "const d = pm.response.json().Data || {};",
                  "pm.environment.set('fermaToken', d.AuthToken);",
                  "pm.environment.set('fermaTokenExp', d.ExpirationDateUtc);",
                  "console.log('Токен до ' + d.ExpirationDateUtc + ' UTC (формат на стенде 20.10.2026 — UUID, не 32 hex)');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Касса и параметры регистрации",
      "item": [
        {
          "name": "1.1 Кассы, ФН, тариф (cashboxes/extended)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/kkt/cloud/stats/cashboxes/extended?AuthToken={{fermaToken}}",
            "description": "Ответ содержит и поля, которых нет в документации: inn, taxModeMask, agentModeMask, isAgent, isInternet, ffdVersion, paymentPlace — ими проверяем, что касса зарегистрирована с нужными параметрами."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const all = pm.response.json().Data || [];",
                  "const ready = all.filter(function (k) { return k.kktState === 'Готова к работе'; });",
                  "pm.test('Есть касса «Готова к работе»', function () { pm.expect(ready.length).to.be.above(0); });",
                  "ready.forEach(function (k) {",
                  "  console.log('Касса ' + k.deviceId + ' РНМ ' + k.rnm + ' ФН ' + k.fn + ' ИНН ' + k.inn + ' ФФД ' + k.ffdVersion +",
                  "    ' агент=' + k.isAgent + ' интернет=' + k.isInternet + ' СНО-маска=' + k.taxModeMask + ' агент-маска=' + k.agentModeMask +",
                  "    ' место=' + k.paymentPlace + ' тариф до ' + k.tariffEndDate + ' ФН заполнен ' + k.fnVolumePercent + '%');",
                  "});",
                  "pm.test('Касса для Totus: ФФД 1.2, признак агента, только интернет', function () {",
                  "  pm.expect(ready.some(function (k) { return k.ffdVersion === '1.2' && k.isAgent === true && k.isInternet === true; })).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Очередь чеков",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/kkt/cloud/stats/receipts/queue/length?AuthToken={{fermaToken}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "console.log('В очереди: ' + pm.response.json().Data.Length);"
                ]
              }
            }
          ]
        }
      ]
    },
