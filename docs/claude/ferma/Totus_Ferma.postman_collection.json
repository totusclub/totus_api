            "url": "{{baseUrl}}/api/kkt/cloud/receipt?AuthToken={{fermaToken}}",
            "description": "Сценарий Е. Одна позиция (ошибка 1058 при двух), ставка НДС обязательна.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Request\": {\n    \"Inn\": \"{{inn}}\",\n    \"Type\": \"IncomeCorrection\",\n    \"InvoiceId\": \"{{invoiceCor}}\",\n    \"CallbackUrl\": \"{{callbackUrl}}\",\n    \"CustomerReceipt\": {\n      \"TaxationSystem\": \"{{taxationSystem}}\",\n      \"IsInternet\": true,\n      \"Email\": \"{{buyerEmail}}\",\n      \"BillAddress\": \"{{billAddress}}\",\n      \"PaymentType\": 4,\n      \"Items\": [\n        {\n          \"Label\": \"Тур: коррекция, заказ {{orderId}}\",\n          \"Price\": {{amountCorrection}},\n          \"Quantity\": 1,\n          \"Amount\": {{amountCorrection}},\n          \"Vat\": \"{{vat}}\",\n          \"Measure\": \"PIECE\",\n          \"PaymentMethod\": 1,\n          \"PaymentType\": 4,\n          \"PaymentAgentInfo\": {\n            \"AgentType\": \"{{agentType}}\",\n            \"SupplierInn\": \"{{supplierInn}}\",\n            \"SupplierName\": \"{{supplierName}}\",\n            \"SupplierPhone\": \"{{supplierPhone}}\"\n          }\n        }\n      ],\n      \"PaymentItems\": [\n        {\n          \"PaymentType\": 1,\n          \"Sum\": {{amountCorrection}}\n        }\n      ],\n      \"CorrectionInfo\": {\n        \"Type\": \"SELF\",\n        \"Description\": \"Чек не сформирован при оплате заказа {{orderId}}\",\n        \"ReceiptDate\": \"{{correctionDate}}\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Уникальный InvoiceId на каждый прогон: <префикс>-<время>-cor-1",
                  "pm.environment.set('invoiceCor', pm.environment.get('invoicePrefix') + '-' + Date.now() + '-cor-1');",
                  "",
                  "// Дата расчёта, к которому относится коррекция, в формате ДД.ММ.ГГ (вчера)",
                  "const y = new Date(Date.now() - 86400000);",
                  "const p = function (n) { return (n < 10 ? '0' : '') + n; };",
                  "pm.environment.set('correctionDate', p(y.getDate()) + '.' + p(y.getMonth() + 1) + '.' + String(y.getFullYear()).slice(2));"
                ]
              }
            },
