            "body": {
              "mode": "raw",
              "raw": "{\n  \"Request\": {\n    \"Inn\": \"{{inn}}\",\n    \"Type\": \"Income\",\n    \"InvoiceId\": \"{{invoicePay}}\",\n    \"CallbackUrl\": \"{{callbackUrl}}\",\n    \"CustomerReceipt\": {\n      \"TaxationSystem\": \"{{taxationSystem}}\",\n      \"IsInternet\": true,\n      \"Email\": \"{{buyerEmail}}\",\n      \"BillAddress\": \"{{billAddress}}\",\n      \"PaymentType\": 4,\n      \"Items\": [\n        {\n          \"Label\": \"Тур: Турция, тестовый отель, 20.11-27.11.2026, заказ {{orderId}}\",\n          \"Price\": {{amountTour}},\n          \"Quantity\": 1,\n          \"Amount\": {{amountTour}},\n          \"Vat\": \"{{vat}}\",\n          \"Measure\": \"PIECE\",\n          \"PaymentMethod\": 1,\n          \"PaymentType\": 4,\n          \"PaymentAgentInfo\": {\n            \"AgentType\": \"{{agentType}}\",\n            \"SupplierInn\": \"{{supplierInn}}\",\n            \"SupplierName\": \"{{supplierName}}\",\n            \"SupplierPhone\": \"{{supplierPhone}}\"\n          }\n        }\n      ],\n      \"PaymentItems\": [\n        {\n          \"PaymentType\": 1,\n          \"Sum\": {{amountTour}}\n        }\n      ],\n      \"CashlessPayments\": [\n        {\n          \"PaymentSum\": {{amountTour}},\n          \"PaymentMethodFlag\": \"{{paymentMethodFlag}}\",\n          \"PaymentIdentifiers\": \"vtb-test-{{orderId}}\"\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Уникальный InvoiceId на каждый прогон: <префикс>-<время>-pay-1",
                  "pm.environment.set('invoicePay', pm.environment.get('invoicePrefix') + '-' + Date.now() + '-pay-1');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200, Status = Success', function () {",
                  "  pm.response.to.have.status(200);",
