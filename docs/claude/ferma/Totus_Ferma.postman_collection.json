    {
      "name": "4. Реестры и сверка",
      "item": [
        {
          "name": "4.1 Реестр чеков за сегодня (list2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/kkt/cloud/list2?AuthToken={{fermaToken}}",
            "description": "На общем тестовом стенде в реестре и чужие чеки — фильтруем по своему префиксу InvoiceId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Request\": {\n    \"StartDateLocal\": \"{{todayStart}}\",\n    \"EndDateLocal\": \"{{todayEnd}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = new Date();",
                  "const p = function (x) { return (x < 10 ? '0' : '') + x; };",
                  "const d = n.getFullYear() + '-' + p(n.getMonth() + 1) + '-' + p(n.getDate());",
                  "pm.environment.set('todayStart', d + 'T00:00:00');",
                  "pm.environment.set('todayEnd', d + 'T23:59:59');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const list = pm.response.json().Data || [];",
                  "const prefix = pm.environment.get('invoicePrefix');",
                  "const ours = list.filter(function (r) { return (r.InvoiceId || '').indexOf(prefix) === 0; });",
                  "console.log('Чеков за день: ' + list.length + ', наших (префикс ' + prefix + '): ' + ours.length);",
                  "ours.forEach(function (r) { console.log(r.InvoiceId + ' → ' + r.StatusCode + ' ' + r.StatusMessage + ' ' + r.Receipt.Type + ' ' + r.Receipt.cashboxInfoHolder.totalSum); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Реестр с деталями (receipts/extended)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/kkt/cloud/stats/receipts/extended?AuthToken={{fermaToken}}&dateFromIncl={{todayStartSql}}&dateToIncl={{todayEndSql}}",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = new Date();",
                  "const p = function (x) { return (x < 10 ? '0' : '') + x; };",
                  "const d = n.getFullYear() + '-' + p(n.getMonth() + 1) + '-' + p(n.getDate());",
                  "pm.environment.set('todayStartSql', encodeURIComponent(d + ' 00:00:00'));",
                  "pm.environment.set('todayEndSql', encodeURIComponent(d + ' 23:59:59'));"
