# totus_API — имена переменных (значения не коммитить; настоящий .env хранится только на сервере)
PORT=3001

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=kedam

# Auth (SECURITY_JWT_PLAN_RU.md). Один JWT_SECRET на все сервисы (totus_ai_v2, calling_api_v2).
JWT_SECRET=
JWT_REFRESH_SECRET=
# log      — запросы без токена пропускаются, но пишутся в лог [AUTH] (по умолчанию)
# enforce  — 401/403
AUTH_MODE=log
# CSV префиксов путей, которые остаются в log-режиме даже при enforce, напр.: /orders,/check_pay
AUTH_LOG_ONLY_PATHS=
# TTL токенов (формат jsonwebtoken: 30d, 12h, 900)
USER_ACCESS_TTL=30d
USER_REFRESH_TTL=90d
AGENT_ACCESS_TTL=12h
AGENT_REFRESH_TTL=30d
STAFF_ACCESS_TTL=12h
STAFF_REFRESH_TTL=30d
# CSV разрешённых origin'ов; пусто = домены totus.club + localhost (см. lib/security.js)
CORS_ORIGINS=
# rate-limit на auth-эндпоинты
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_LIMIT=30

EMAIL_USER=
EMAIL_PASS=
PARTNER_API_KEY=
LT_API_TOKEN=
LT_CLIENT_AUTH_TOKEN=
VTB_CALLBACK_URL=https://api.totus.club/vtb/callback
YANDEX_SMARTCAPTCHA_SERVER_KEY=
ORDER_REQUESTS_NOTIFY_EMAIL=
# Необязательно. Адреса сотрудников (через запятую) для писем «Новое бронирование Arlekino №…» —
# бронирования наших Room Type без Level.Travel (docs/CUSTOM_ROOMS_API.md §6).
BOOKINGS_NOTIFY_EMAIL=
UPLOAD_MAX_IMAGE_MB=15

# --- Секреты интеграций (Б.1, lib/env.js). Fallback-значений в коде больше нет: ---
# ОБЯЗАТЕЛЬНО. Level.Travel partner token: заголовок Authorization: Token token="…" и ключ подписи
# для orders/{id}/notify (сумма/статус). Алиас для совместимости: LT_PARTNER_API_KEY.
# (LT_API_TOKEN= выше — то же самое; заполните одно из двух.)
# Необязательно. Cookie uuid для POST /create-package (orders/create); если пусто — Cookie не отправляется.
LT_SESSION_UUID=
# ОБЯЗАТЕЛЬНО. VTB Open API (СБП): client_id (он же заголовок X-IBM-Client-Id).
VTB_CLIENT_ID=
# ОБЯЗАТЕЛЬНО. VTB Open API: client_secret для /passport/oauth2/token.
VTB_CLIENT_SECRET=
# ОБЯЗАТЕЛЬНО. VTB: заголовок Merchant-Authorization (идентификатор мерчанта).
VTB_MERCHANT_AUTH=
# Необязательно. Telegram Gateway token для верификации по телефону
# (POST /api/auth/verification-code). Если пусто — эндпоинт отвечает 503.
TELEGRAM_GATEWAY_TOKEN=

# --- Хаб уведомлений calling_api_v2 (push/in-app: заказы, оплата, документы, обращения; lib/notifyHub.js) ---
# Необязательно. Если обе переменные не заданы — уведомления отключены (один warn в логе, вызовы no-op).
# URL хаба (на одном сервере — локальный порт calling_api_v2).
NOTIFY_HUB_URL=http://127.0.0.1:4444
# Ключ заголовка X-Internal-Key — ТО ЖЕ значение, что INTERNAL_API_KEY в .env calling_api_v2 (openssl rand -hex 32).
INTERNAL_API_KEY=

# --- Онлайн-касса Ferma (OFD.ru): lib/ferma, docs/FERMA_API.md, docs/claude/FERMA_TESTING_RU.md ---
# off (по умолчанию) — выключено | test — только тестовый стенд ferma-test.ofd.ru | live — боевая касса ferma.ofd.ru.
# Чеки по заказам — FERMA_RECEIPT_TRIGGER ниже (payment — только после подтверждения оплаты банком).
FERMA_MODE=off
# Необязательно: по умолчанию https://ferma-test.ofd.ru (test) или https://ferma.ofd.ru (live); другой хост режим не пустит.
FERMA_BASE_URL=
# test: логин и пароль публичного стенда — документация Ferma §5.2 (касса ФФД 1.2). live: из ЛКК OFD.ru → Ferma.
FERMA_LOGIN=
FERMA_PASSWORD=
# ИНН организации кассы. test: 3245001416 (тестовая организация стенда). live: 9729424935 (ООО «ТОТУСКЛАБ»).
FERMA_INN=
# Система налогообложения из регистрации кассы: Common | SimpleIn | SimpleInOut | Patent … (test: Common).
FERMA_TAXATION_SYSTEM=Common
# Признак агента: AGENT | COMMISSIONER | CONFIDANT (по договору с Level.Travel, вопрос Ф2).
FERMA_AGENT_TYPE=AGENT
# Ставка НДС позиции: VatNo | Vat0 | Vat5 | Vat7 | Vat10 | Vat22 | CalculatedVat… (вопрос Ф4 бухгалтеру).
FERMA_VAT=VatNo
FERMA_BILL_ADDRESS=https://totus.club
# Признак способа оплаты безналичными (тег 1236). Пусто — блок CashlessPayments не передаётся (вопрос Ф13 к OFD.ru).
FERMA_PAYMENT_METHOD_FLAG=
# Почта покупателя в режиме test (стенд общий — настоящую почту туда не шлём).
FERMA_TEST_EMAIL=test@example.com
# Префикс InvoiceId: по умолчанию tc-test (test) / tc (live).
FERMA_INVOICE_PREFIX=
# Callback Ferma → POST {FERMA_CALLBACK_BASE}/api/ferma/callback/{FERMA_CALLBACK_SECRET}. Секрет: openssl rand -hex 16.
# Пусто — callback не передаётся, статусы узнаёт фоновая сверка.
FERMA_CALLBACK_BASE=https://api.totus.club
FERMA_CALLBACK_SECRET=
FERMA_TIMEOUT_MS=20000
# Фоновая сверка незавершённых чеков: 1 — включена, 0 — выключена; интервал в мс.
FERMA_WORKER=1
FERMA_WORKER_INTERVAL_MS=60000
# Только для одной боевой проверки на 1 ₽ (FERMA_TESTING_RU.md, Т15); в остальное время 0.
FERMA_ALLOW_LIVE_RECEIPTS=0
# Когда пробивать чек по заказу: off — никогда (по умолчанию);
# payment — ТОЛЬКО после подтверждения оплаты банком (RECONCILED в /vtb/callback, /check_pay);
# booking — ВРЕМЕННО для проверки: при создании бронирования (/create-package), только при FERMA_MODE=test.
FERMA_RECEIPT_TRIGGER=off
# Поставщик для агентского чека в live (в test — тестовый поставщик).
# Туры Level.Travel: НЕ настраивается — юрлицо туроператора берётся из каждого заказа (operator_organization,
# таблица order_suppliers). Ключи "lt" и "lt:<id>" больше не читаются.
# Номера Arlekino: JSON в одну строку {"arlekino":{"inn":"…","name":"…","phone":"…"}}.
# Нет реквизитов — боевой чек не пробивается: лог [FERMA] payment … чек НЕ пробит, GET /api/admin/fiscal/blocked.
FERMA_SUPPLIERS=

# --- Прогретый кеш поиска туров (lib/searchCache.js, docs/SEARCH_CACHE_RU.md) ---
# on — каждую ночь искать форму по умолчанию для всех стран и отдавать повторный поиск из снимка сразу.
SEARCH_CACHE=off
# Время ночного прогрева по Москве, ЧЧ:ММ.
SEARCH_CACHE_TIME=00:05
# Что прогревать (как форма поиска на сайте и в приложении по умолчанию).
SEARCH_CACHE_FROM_CITY=Moscow
SEARCH_CACHE_DAYS_AHEAD=7
SEARCH_CACHE_NIGHTS=7
SEARCH_CACHE_ADULTS=2
# Пусто — все страны из /references/destinations; иначе ISO2 через запятую (EG,TR,AE).
SEARCH_CACHE_COUNTRIES=
# Одновременных поисков при прогреве; сколько часов отдавать снимок; не чаще чем раз в N минут
# обновлять снимок в фоне, когда его попросил пользователь.
SEARCH_CACHE_CONCURRENCY=3
SEARCH_CACHE_MAX_AGE_HOURS=26
SEARCH_CACHE_REFRESH_MINUTES=10
# Папка снимков (по умолчанию var/search-cache в корне API, в Git не попадает).
SEARCH_CACHE_DIR=
