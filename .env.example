# totus_API — имена переменных (значения не коммитить; настоящий .env хранится только на сервере)
PORT=3001

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=kedam

# Auth (SECURITY_JWT_PLAN_RU.md). Один JWT_SECRET на все сервисы (totus_ai_v2, calling_api_v2).
JWT_SECRET=
JWT_REFRESH_SECRET=
# log      — запросы без токена пропускаются, но пишутся в лог [AUTH] (по умолчанию)
# enforce  — 401/403
AUTH_MODE=log
# CSV префиксов путей, которые остаются в log-режиме даже при enforce, напр.: /orders,/check_pay
AUTH_LOG_ONLY_PATHS=
# TTL токенов (формат jsonwebtoken: 30d, 12h, 900)
USER_ACCESS_TTL=30d
USER_REFRESH_TTL=90d
AGENT_ACCESS_TTL=12h
AGENT_REFRESH_TTL=30d
STAFF_ACCESS_TTL=12h
STAFF_REFRESH_TTL=30d

# --- CORS (lib/corsPolicy.js) ---
# CSV разрешённых origin'ов; пусто = домены totus.club + Origin десктопа (null) + localhost.
# Значение * открывает API любому сайту — использовать только осознанно.
CORS_ORIGINS=
# Режим whitelist'а — НЕ зависит от AUTH_MODE:
#   log      — неизвестный origin пропускается, пишется строка [CORS] (по умолчанию)
#   enforce  — неизвестный origin получает 403 и до маршрутов не доходит
CORS_MODE=log
# Сколько секунд браузер кэширует ответ на preflight (OPTIONS). Пусто = 600.
CORS_MAX_AGE=600

# rate-limit на auth-эндпоинты
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_LIMIT=30

# --- Документы заказа (docs/ORDER_DOCS_RU.md) ---
# Срок жизни подписанной ссылки на PDF. Пусто = 86400 (сутки).
ORDER_DOC_LINK_TTL_SECONDS=
# strict (по умолчанию) — чужой/анонимный запрос получает 401/403;
# log — аварийный откат к прежней отдаче без проверки.
ORDER_DOCS_ACCESS=strict

# --- Вход через Яндекс ID (docs/YANDEX_AUTH_API.md). Пусто — раздел выключен (503). ---
# ClientID и Client secret приложения с oauth.yandex.ru (права login:info, login:email, login:avatar).
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# Redirect URI, указанный в приложении Яндекса — именно на этот адрес возвращается код.
YANDEX_OAUTH_REDIRECT_URI=https://api.totus.club/api/auth/yandex/callback
# Куда сервер уводит пользователя после обмена кода: сайт и deep link приложения/десктопа.
YANDEX_AUTH_RETURN_WEB=https://totus.club
YANDEX_AUTH_RETURN_APP=totus://auth/yandex
YANDEX_AUTH_RETURN_DESKTOP=totus://auth/yandex

EMAIL_USER=
EMAIL_PASS=
PARTNER_API_KEY=
LT_API_TOKEN=
LT_CLIENT_AUTH_TOKEN=
VTB_CALLBACK_URL=https://api.totus.club/vtb/callback
YANDEX_SMARTCAPTCHA_SERVER_KEY=
ORDER_REQUESTS_NOTIFY_EMAIL=
# Необязательно. Адреса сотрудников (через запятую) для писем «Новое бронирование Arlekino №…» —
# бронирования наших Room Type без Level.Travel (docs/CUSTOM_ROOMS_API.md §6).
BOOKINGS_NOTIFY_EMAIL=
UPLOAD_MAX_IMAGE_MB=15

# --- Секреты интеграций (Б.1, lib/env.js). Fallback-значений в коде больше нет: ---
# ОБЯЗАТЕЛЬНО. Level.Travel partner token: заголовок Authorization: Token token="…" и ключ подписи
# для orders/{id}/notify (сумма/статус). Алиас для совместимости: LT_PARTNER_API_KEY.
# (LT_API_TOKEN= выше — то же самое; заполните одно из двух.)
# Необязательно. Cookie uuid для POST /create-package (orders/create); если пусто — Cookie не отправляется.
LT_SESSION_UUID=
# ОБЯЗАТЕЛЬНО. VTB Open API (СБП): client_id (он же заголовок X-IBM-Client-Id).
VTB_CLIENT_ID=
# ОБЯЗАТЕЛЬНО. VTB Open API: client_secret для /passport/oauth2/token.
VTB_CLIENT_SECRET=
# ОБЯЗАТЕЛЬНО. VTB: заголовок Merchant-Authorization (идентификатор мерчанта).
VTB_MERCHANT_AUTH=
# Необязательно. Telegram Gateway token для верификации по телефону
# (POST /api/auth/verification-code). Если пусто — эндпоинт отвечает 503.
TELEGRAM_GATEWAY_TOKEN=

# --- Хаб уведомлений calling_api_v2 (push/in-app: заказы, оплата, документы, обращения; lib/notifyHub.js) ---
# Необязательно. Если обе переменные не заданы — уведомления отключены (один warn в логе, вызовы no-op).
# URL хаба (на одном сервере — локальный порт calling_api_v2).
NOTIFY_HUB_URL=http://127.0.0.1:4444
# Ключ заголовка X-Internal-Key — ТО ЖЕ значение, что INTERNAL_API_KEY в .env calling_api_v2 (openssl rand -hex 32).
INTERNAL_API_KEY=
